{
  "name": "deepFocus",
  "productName": "Deep Focus",
  "version": "2.4.7",
  "main": ".vite/build/main.js",
  "scripts": {
    "prebuild": "node scripts/build.js",
    "build": "electron-builder --dir",
    "package": "npm run prebuild && electron-builder --dir",
    "make": "npm run prebuild && electron-builder",
    "dist": "npm run prebuild && electron-builder",
    "start": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && vite build --config vite.renderer.config.mts && electron .",
    "lint": "eslint --ext .ts,.tsx ."
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-dmg": "^7.10.2",
    "@electron-forge/maker-pkg": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron-forge/plugin-vite": "^7.10.2",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron/fuses": "^1.8.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node-schedule": "^2.1.8",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "cross-env": "^10.1.0",
    "electron": "^39.2.3",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-solid": "^0.14.5",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-static-copy": "^3.1.4"
  },
  "keywords": [],
  "author": {
    "name": "Timeo Williams",
    "email": "timwillie73@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "@corvu/utils": "^0.4.2",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@kobalte/core": "^0.13.11",
    "@modular-forms/solid": "^0.25.1",
    "@solidjs/router": "^0.15.4",
    "autoprefixer": "^10.4.22",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "electron-log": "^5.4.3",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "flag-icons": "^7.5.0",
    "gsap": "^3.13.0",
    "node-schedule": "^2.1.1",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "shepherd.js": "^14.5.1",
    "solid-chartjs": "^1.3.11",
    "solid-js": "^1.9.10",
    "solid-motionone": "^1.0.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "tailwindcss-animate": "^1.0.7",
    "vinxi": "^0.5.8",
    "vite-plugin-solid": "^2.11.10",
    "world-countries": "^5.1.0"
  },
  "build": {
    "appId": "com.electron.deepfocus",
    "productName": "Deep Focus",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      ".vite/build/**/*",
      ".vite/renderer/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.icns",
        "to": "icon.icns"
      },
      {
        "from": "resources/icon_green.png",
        "to": "icon_green.png"
      },
      {
        "from": "resources/icon_red.png",
        "to": "icon_red.png"
      },
      {
        "from": "resources/icon_yellow.png",
        "to": "icon_yellow.png"
      },
      {
        "from": "resources/icon_blue.png",
        "to": "icon_blue.png"
      },
      {
        "from": "resources/DOG_MEME.avif",
        "to": "DOG_MEME.avif"
      },
      {
        "from": "resources/trayIcon.png",
        "to": "trayIcon.png"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        },
        {
          "target": "zip",
          "arch": ["arm64"]
        }
      ],
      "icon": "resources/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "Deep Focus",
      "icon": "resources/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "format": "ULFO"
    },
    "win": {
      "target": ["nsis", "zip"]
    },
    "linux": {
      "target": ["AppImage", "deb", "rpm"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
