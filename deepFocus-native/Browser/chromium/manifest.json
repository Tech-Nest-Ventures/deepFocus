{
  "manifest_version": 3,
  "name": "Deep Focus Browser Monitor",
  "version": "0.2.0",
  "description": "Show your active public tab in Deep Focus on this Mac. The extension saves no URL history.",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Deep Focus",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:17322"
  },
  "minimum_chrome_version": "120",
  "incognito": "not_allowed"
}
